# Шаблон окружения SFMShop: скопируй в .env и подставь свои значения.
# Настоящие значения в git не попадают: .env лежит в .gitignore.

# Основная база (src/database/connection.py, src/database/async_repository.py)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sfmshop
DB_USER=postgres
DB_PASSWORD=your-db-password

# JWT-токены (src/core/config.py)
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30

# Redis для кэша (src/services/cache_service.py)
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB для логов (src/services/log_service.py)
MONGO_HOST=localhost
MONGO_PORT=27017

# Режим и мониторинг
DEBUG=False
SENTRY_DSN=

# Помощник поддержки (src/services/support_service.py)
LLM_API_KEY=your-vsegpt-key
LLM_BASE_URL=https://api.vsegpt.ru/v1
LLM_MODEL=openai/gpt-4o-mini
