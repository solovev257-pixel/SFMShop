# Шаблон окружения SFMShop: скопируй в .env и подставь свои значения.
# Настоящие значения в git не попадают: .env лежит в .gitignore.

# Основная база (src/database/connection.py, src/database/async_repository.py)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sfmshop
DB_USER=postgres
DB_PASSWORD=your-db-password

# JWT-токены (src/core/config.py)
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30

# Redis для кэша (src/services/cache_service.py)
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB для логов (src/services/log_service.py)
MONGO_HOST=localhost
MONGO_PORT=27017

# Режим и мониторинг
DEBUG=False
SENTRY_DSN=

# Помощник поддержки (src/services/support_service.py)
LLM_API_KEY=
LLM_BASE_URL=https://api.vsegpt.ru/v1
LLM_MODEL=openai/gpt-4o-mini

# Очередь и внешние сервисы
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=sfmshop
RABBITMQ_PASSWORD=your-rabbitmq-password
EXCHANGE_BASE_URL=https://api.exchangerate-api.com/v4/latest
ORDER_DETAILS_API_URL=https://api.orders.sfmshop.ru/order
LLM_TIMEOUT=10
LLM_MAX_TOKENS=400

# Порты Docker на компьютере разработчика
APP_PORT=8000
POSTGRES_PORT=5433
REDIS_EXTERNAL_PORT=6380

# Пустое значение отключает чтение .env Python-приложением (например в CI).
# SFMShop_ENV_FILE=
